# Server-only configuration (no NEXT_PUBLIC_* values; nothing here reaches the browser).
# Copy to .env.local. Validated lazily by src/lib/env.ts; a missing key is named in the error.

# Internal base URL of the Spring Boot API (no trailing slash, no /api/v1)
API_INTERNAL_URL=http://localhost:8081
# Public origin of this storefront (used for canonical URLs, sitemap, robots)
SITE_URL=http://localhost:3000
# local | test | dev | staging | prod. /mock-payment is served only for local and test.
APP_ENV=local
# Set to "false" ONLY for plain-http local development; any other value keeps cookies Secure.
SESSION_COOKIE_SECURE=false
